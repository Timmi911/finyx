# Normalize line endings to LF (avoid CRLF warnings on Windows)
* text=auto eol=lf

# Binary files (no line ending conversion)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.apk binary
*.aab binary
*.jar binary
